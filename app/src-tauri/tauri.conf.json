{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mapa Interactive Enshrouded",
  "version": "1.0.1",
  "identifier": "io.github.enshrouded-map-interactive",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npx vite",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Mapa Interactive Enshrouded", "width": 1600, "height": 960, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
